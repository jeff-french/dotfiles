[credential]

[core]
	excludesfile = ~/.gitignore_global
	editor = vim 
[user]
	name = Jeff French
	email = 209994+jeff-french@users.noreply.github.com
        signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIG9OtpQYCMjgKIeFj4j2Ch8PzIPyZdNndWseSbxc5XD3
[gpg]
        format = ssh

[gpg "ssh"]
        program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
        gpgsign = true
[diff]
	tool = diffmerge
[difftool "diffmerge"]
	cmd = /usr/bin/diffmerge \"$LOCAL\" \"$REMOTE\"
[merge]
	tool = diffmerge
[mergetool "diffmerge"]
	cmd = /usr/local/bin/diffmerge --merge --result=\"$MERGED\" \"$LOCAL\" \"$BASE\" \"$REMOTE\"
	trustExitCode = true
[push]
	default = simple
[alias]
	last = log -1 HEAD
	s = status --short

[diff "sopsdiffer"]
	textconv = sops -d
[pull]
	rebase = true
